      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n\n  if (Array.isArray(item.json.steps)) {\n    item.json.steps = item.json.steps\n      .map((step, index) => `${index + 1}. ${step}`)\n      .join(\"\\n\\n\");\n  }\n\n}\n\nreturn $input.all();"
      },
